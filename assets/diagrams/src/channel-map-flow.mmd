  A["<b>Create the named section</b><br/><code>00454103  push 0</code><br/>// Sets the high-order size to zero.<br/><code>00454105  push 4</code><br/>// Requests PAGE_READWRITE protection.<br/><code>00454107  push [ebp-0x58]</code><br/>// Pushes the channel security attributes.<br/><code>0045410E  push -1</code><br/>// Uses INVALID_HANDLE_VALUE for a paging-file-backed section.<br/><code>00454110  call CreateFileMappingA</code><br/>// Creates the named section."]
  B["<b>Map the section read/write</b><br/>// Handle validation and name setup omitted from this excerpt.<br/><code>00454133  push 0xF001F</code><br/>// Requests FILE_MAP_ALL_ACCESS.<br/><code>00454138  push esi</code><br/>// Pushes the section handle.<br/><code>00454139  call MapViewOfFile</code><br/>// Maps the section into the service process."]
  READY["<b>Shared section</b><br/>// The peer opens and maps the same name."]

  A --> B
  B --> READY

