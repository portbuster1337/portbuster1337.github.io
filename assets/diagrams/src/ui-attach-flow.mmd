flowchart TB
  A["<b>Open the UI mutex</b><br/><code>004167F0  push 0xADEC30</code><br/>// Pushes the Global\HttpDebuggerUiStarted name.<br/><code>004167F5  push 0</code><br/>// Sets the inherit flag to false.<br/><code>004167F7  push 0x1F0001</code><br/>// Requests MUTEX_ALL_ACCESS.<br/><code>004167FF  call OpenMutexA</code><br/>// Opens the service-created UI mutex.<br/><code>00416805  mov [esi+0x0C], eax</code><br/>// Stores the mutex handle in the UI object.<br/><code>00416808  test eax, eax</code><br/>// Checks whether the open succeeded.<br/><code>0041680A  je loc_416D01</code><br/>// Branches to the failure path on a null handle."]
  B["<b>Open the channel names</b><br/><code>00416812  push 0xADEC50</code><br/>// Pushes the Global\HttpDebuggerIpcSettings name.<br/>// Mapping setup for this channel omitted.<br/><code>0041685D  push 0xADEC98</code><br/>// Pushes the Global\HttpDebuggerIpcEngineCommand name.<br/>// Mapping setup for this channel omitted.<br/><code>004168AD  push 0xADECBC</code><br/>// Pushes the Global\HttpDebuggerIpcHttpNotification name.<br/>// Mapping setup for this channel omitted.<br/><code>004168F8  push 0xADECE4</code><br/>// Pushes the Global\HttpDebuggerIpcConnectionInfo name.<br/>// Mapping setup for this channel omitted.<br/><code>0041693F  push 0xADED0C</code><br/>// Pushes the Global\HttpDebuggerIpcHttpTransaction name."]
  C["<b>sub_417A90</b><br/>// Maps each named channel in turn."]
  FAIL["<b>loc_416D01</b><br/>// Failure path outside this excerpt."]
  READY["<b>UI attached</b><br/>// Same sections as the service, different process."]

  A -->|success| B
  A -->|failure| FAIL
  B -->|each name| C
  C --> READY

  classDef block fill:#ffffff,stroke:#111111,color:#111111,stroke-width:1.5px;
  classDef helper fill:#f4f4f4,stroke:#111111,color:#111111,stroke-width:1.5px,stroke-dasharray:4 2;
  classDef fail fill:#ffffff,stroke:#111111,color:#111111,stroke-width:1.5px,stroke-dasharray:2 2;
  classDef endnode fill:#111111,stroke:#111111,color:#ffffff,stroke-width:1.5px;
  class A block;
  class B block;
  class C helper;
  class FAIL fail;
  class READY endnode;
  linkStyle default stroke:#111111,stroke-width:1.5px;
